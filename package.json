{
  "name": "stateloop",
  "version": "1.0.0",
  "type": "module",
  "description": "Stateless agent orchestration system for restaurant negotiation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run swagger:generate && tsx watch src/index.ts",
    "build": "npm run swagger:generate && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "swagger:generate": "tsx scripts/swagger-generate.ts",
    "swagger:compare": "tsx scripts/swagger-compare.ts",
    "swagger:migrate": "npm run swagger:generate && npm run swagger:compare"
  },
  "keywords": [
    "agent",
    "orchestration",
    "stateless",
    "negotiation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "marked": "^12.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "supertest": "^7.2.2",
    "swagger-autogen": "^2.23.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
